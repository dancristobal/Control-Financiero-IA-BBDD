# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MY_GEMINI_API_KEY: Optional custom secret for direct free-tier API key paste without billing prompts.
MY_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_ID: Optional ID of the user's Google Sheet (extracted from the sheet URL).
# Can also be set directly in the application's Configuración panel.
GOOGLE_SHEETS_ID=""

# GOOGLE_SHEETS_ENDPOINT_URL: Optional Google Apps Script Web App URL or proxy endpoint.
# When deployed, invoices are automatically appended to the "Facturas" sheet tab.
GOOGLE_SHEETS_ENDPOINT_URL=""

# GOOGLE_DRIVE_FOLDER_ID: Optional specific Google Drive folder ID where invoices and supplier folders are stored.
GOOGLE_DRIVE_FOLDER_ID=""

